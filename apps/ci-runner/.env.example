# Kopiera till apps/ci-runner/.env (checkas ALDRIG in — den bär PAT:en).
# deploy.sh skickar filen till /opt/hosting/apps/ci-runner/.env med chmod 600.

# PAT som bara används för att mynta kortlivade registreringstokens mot bus-analyzer.
# Fine-grained, scopad till ENBART esnil/bus-analyzer, behörighet "Administration: read & write"
# (klassisk motsvarighet: `repo`). Håll den så smal — den ligger på en produktionsvärd.
# Entrypointen re-execar med `env -u GH_PAT` efter registreringen, så jobbkoden ser den aldrig.
GH_PAT=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vilka ci.yml-jobb den här runnern får ta (kommaseparerat, inga mellanslag):
#   e2e  → frontend/Playwright-jobbet
#   ci2  → backend- och bridge-jobben
# EN runner på VPS:en bär båda — annars kan hela pipelinen inte köras här.
RUNNER_LABELS=e2e,ci2

# Prefix i GitHubs runnerlista. Slutnamnet blir <prefix>-<container hostname> = vps-ci-runner.
RUNNER_NAME_PREFIX=vps

# Valfritt: annat repo (default esnil/bus-analyzer).
#GH_REPO=esnil/bus-analyzer

# Valfria deploy.sh-overrides (används bara lokalt, skickas inte till servern):
#VPS_HOST=217.154.83.127
#VPS_USER=deploy
#BA_DIR=../bus-analyzer
